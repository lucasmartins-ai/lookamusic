{
  "name": "lookamusic",
  "version": "1.2.1",
  "private": true,
  "description": "LookaMusic — browser-based real-time voice-to-band instrument. You sing, LookaMusic builds the band.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:tauri": "node scripts/build-tauri.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:start": "electron electron/main.cjs",
    "desktop:build": "next build && electron-builder",
    "desktop:dist:mac": "next build && electron-builder --mac",
    "desktop:dist:win": "next build && electron-builder --win",
    "desktop:dist:linux": "next build && electron-builder --linux",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
